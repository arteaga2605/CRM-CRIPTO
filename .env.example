# Crypto CRM Environment Variables

# Database
DATABASE_URL=sqlite:///./crypto_crm.db

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Exchange (opcional)
EXCHANGE_ID=binance
EXCHANGE_API_KEY=tu_api_key_aqui
